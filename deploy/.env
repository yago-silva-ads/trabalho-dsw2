# Copie para .env e ajuste os valores: cp .env.example .env

# Fuso horario
TZ=America/Sao_Paulo

# Banco de dados
DB_NAME=waldo_contabilidade
DB_USER=root
# Defina uma senha forte ANTES da primeira subida: o MySQL so le DB_PASSWORD
# quando o banco e criado. Mudar depois exige "docker compose down -v" (perde os dados).
DB_PASSWORD=troque-por-uma-senha-forte
# "mysql" e o nome do servico no docker-compose
DB_URL=jdbc:mysql://mysql:3306/waldo_contabilidade?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=America/Sao_Paulo

# Chave usada uma unica vez para criar o primeiro administrador (POST /api/auth/bootstrap)
APP_BOOTSTRAP_SECRET=troque-este-segredo-por-um-valor-bem-grande-e-aleatorio

# Portas expostas na maquina
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Front-end: endereco da API visto pelo NAVEGADOR (na VM, use o IP publico, nunca localhost)
API_URL=http://localhost:8080
# Back-end: origens autorizadas a chamar a API (endereco do front-end)
CORS_ORIGINS=http://localhost:4200
